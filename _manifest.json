{
  "manifest_version": 2,
  "version": "1.3.0",
  "name": "错误输出重定向",
  "description": "当 Bot 出站文本包含指定关键词时拦截并重定向/抑制；可分别配置对触发消息与对会话的沉默秒数。",
  "author": {
    "name": "FlandreSatori",
    "url": "https://github.com/FlandreSatori"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/FlandreSatori/maibot_plugin_redirect_err",
    "homepage": "https://github.com/FlandreSatori/maibot_plugin_redirect_err",
    "issues": "https://github.com/FlandreSatori/maibot_plugin_redirect_err/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "chat.get_all_streams",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "message.get_by_id",
    "message.get_recent",
    "maisaka.context.append",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "maibot_plugin.redirect_err"
}
